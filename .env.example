# Sahaya AI Environment Variables

# Backend (.env in the backend/ directory or project root)

# Project Settings
PROJECT_NAME="Sahaya AI"
API_V1_STR="/api/v1"
SEED_ON_STARTUP="True"

# Security (Change in production)
JWT_SECRET="supersecretjwtkeyforlocaldevelopmentonly"
ACCESS_TOKEN_EXPIRE_MINUTES="3600"

# Database Configuration
DATABASE_URL="sqlite:///./sahaya_ai.db"

# NVIDIA NIM AI Configuration
# Get your API key from https://build.nvidia.com/
NIM_API_KEY="your_nvidia_api_key_here"
NIM_MODEL="meta/llama3-70b-instruct"
NIM_BASE_URL="https://integrate.api.nvidia.com/v1"

# Frontend (.env.local in the frontend/ directory)
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
